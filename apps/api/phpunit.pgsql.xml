<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/postgres-bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL catalog">
            <directory>tests/Postgres</directory>
            <file>tests/Feature/TravellerAccountTest.php</file>
            <file>tests/Feature/ItineraryTest.php</file>
            <file>tests/Feature/PasswordByteLimitTest.php</file>
            <file>tests/Feature/PasswordSessionTest.php</file>
            <file>tests/Feature/RoomCatalogTest.php</file>
            <file>tests/Feature/HotelDiscoveryTest.php</file>
            <file>tests/Feature/HotelClassificationTest.php</file>
            <file>tests/Feature/ManualCatalogTest.php</file>
            <file>tests/Feature/PmsConnectionTest.php</file>
            <file>tests/Feature/HotelAccessTest.php</file>
            <file>tests/Feature/HotelPhotoTest.php</file>
            <file>tests/Feature/HotelOnboardingTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="55434"/>
        <env name="DB_USERNAME" value="niwadu_catalog_test"/>
        <env name="DB_DATABASE" value="niwadu_catalog_test_a1"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="log"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
